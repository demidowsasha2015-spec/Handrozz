<Window x:Class="UniMouse.Wpf.Views.StepEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:UniMouse.Wpf"
        Title="{Binding Title}" Height="560" Width="980"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <wpf:StepKindTokenConverter x:Key="KindTok" />
        <wpf:BoolToVisibilityConverter x:Key="BoolVis" />
        <wpf:StepErrorFormatter x:Key="ErrFmt" />
    </Window.Resources>
    <DockPanel Margin="10">

        <!-- toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Add step:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="+ Key"        Click="AddKey_Click"   Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Button Content="+ Text"       Click="AddText_Click"  Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Button Content="+ Move"       Click="AddMove_Click"  Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Button Content="+ Click"      Click="AddClick_Click" Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Button Content="+ Scroll"     Click="AddScroll_Click" Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Button Content="+ Delay"      Click="AddDelay_Click" Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Separator Width="16" Background="Transparent" />
            <Button Content="Up"     Click="MoveUp_Click"   Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Button Content="Down"   Click="MoveDown_Click" Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
            <Button Content="Delete" Click="Delete_Click"   Padding="8,3" Margin="2,0" IsEnabled="{Binding CanEdit}" />
        </StackPanel>

        <!-- bottom bar -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SaveResult}" TextWrapping="Wrap"
                       Foreground="#B30000" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save" Click="Save_Click" Padding="16,6" Margin="0,0,8,0"
                        FontSize="13" IsEnabled="{Binding CanEdit}" />
                <Button Content="Close" Click="Close_Click" Padding="16,6" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- steps grid -->
        <DataGrid x:Name="StepsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  IsReadOnly="{Binding IsReadOnly}" SelectionMode="Single" GridLinesVisibility="All">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#FFE7E4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding DisplayNumber}" IsReadOnly="True" Width="36" />

                <DataGridTemplateColumn Header="Kind" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding KindToken}"
                                      ItemsSource="{x:Static wpf:EditorLists.Kinds}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Delay before (ms)" Binding="{Binding DelayBeforeText}" Width="110" />

                <DataGridTemplateColumn Header="Hold (ms)" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding HoldText}"
                                       Visibility="{Binding ShowHold, Converter={StaticResource BoolVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Key" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ShowKey, Converter={StaticResource BoolVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Text" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ShowText, Converter={StaticResource BoolVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="X" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ShowCoords, Converter={StaticResource BoolVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Y" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ShowCoords, Converter={StaticResource BoolVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Button" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Button}"
                                      ItemsSource="{x:Static wpf:EditorLists.Buttons}"
                                      Visibility="{Binding ShowClick, Converter={StaticResource BoolVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Clicks" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Clicks, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ShowClick, Converter={StaticResource BoolVis}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Scroll dir/notches" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowScroll, Converter={StaticResource BoolVis}}">
                                <ComboBox SelectedItem="{Binding ScrollDirection}"
                                          ItemsSource="{x:Static wpf:EditorLists.Scrolls}" Width="56" Margin="0,0,4,0" />
                                <TextBox Text="{Binding ScrollAmount, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Error" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="#B30000" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ErrFmt}">
                                        <Binding Path="Index" />
                                        <Binding Path="Error" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
